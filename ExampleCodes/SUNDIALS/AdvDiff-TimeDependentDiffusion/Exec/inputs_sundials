# MLMG settings for the SUNDIALS preconditioner solve
mlmg.max_iter = 100
mlmg.max_fmg_iter = 0
mlmg.verbose = 1
mlmg.bottom_verbose = 2
mlmg.reltol = 1.e-4
mlmg.abstol = 0.0
mlmg.max_coarsening_level = 0 # set to 0 to use hypre on all levels
mlmg.use_hypre = 1
mlmg.hypre_interface = 3  # 1 = structed, 2 = semi_structed, 3 = ij
mlmg.hypre_options_namespace = hypre

# HYPRE settings used when mlmg.use_hypre = 1 and mlmg.hypre_interface = 3
hypre.hypre_solver = BoomerAMG
hypre.recompute_preconditioner = false
hypre.verbose = 2
hypre.logging = 2
hypre.write_matrix_files = false
